# Local configuration may contain secrets: only config.example.json is tracked.
/config.json
*.overrides.json
*.stats.json
/bin/

# Browser extension prototype
extension/node_modules/
extension/dist/
extension/coverage/
extension/spikes402-extension.zip

# Local Compose / environment secrets
.env
.env.*

# Default on-disk state (spent tokens, withdrawal intents)
/state/

# Generated SBOMs and local scan reports (CI uploads the CycloneDX files as artifacts)
/sbom/*.cdx.json
/sbom/*.json
/sbom/*.tar
